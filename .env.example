# Copie para .env.local e preencha

# MongoDB (local ou Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/clikou

# Segredo do cookie de sessão (gere um: openssl rand -hex 32)
AUTH_SECRET=troque-por-um-segredo-forte

# URL pública do app (usada nos redirects do Mercado Pago)
APP_URL=http://localhost:3000

# Google Cloud Storage — deixe vazio para salvar as fotos em .data/uploads (dev)
GCS_BUCKET=
# Em dev, aponte para a chave da service account:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/chave.json

# Mercado Pago — deixe vazio para "modo dev" (compra aprovada na hora, sem pagar)
MP_ACCESS_TOKEN=

# Login com Google (OAuth) — https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado: APP_URL/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Porcentagem da plataforma em cada venda
COMMISSION_PERCENT=20

# E-mails com acesso ao painel admin (/admin), separados por vírgula
ADMIN_EMAILS=

# MailerSend (https://app.mailersend.com) — token "mlsn.…" para enviar e-mails.
# Vazio = modo dev: cadastro por senha entra sem confirmação de e-mail.
MAILERSEND_TOKEN=
# Remetente (o domínio precisa estar verificado no MailerSend)
EMAIL_FROM=nao-responda@clicou.online
